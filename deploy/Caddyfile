# Caddy gets and renews the certificate itself, passes WebSockets through, and
# sends the Host and X-Forwarded-Proto headers WebTerm needs.
#
# Replace the name with yours, and "webterm" with wherever WebTerm
# listens (the compose service name if Caddy shares its network, or 127.0.0.1).

webterm.example.com {
	reverse_proxy webterm:3000
}
